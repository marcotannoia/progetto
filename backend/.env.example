# Ambiente: development oppure production
APP_ENV=development
PORT=5000

# Genera un valore casuale lungo, ad esempio con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret

# Origini frontend consentite, separate da virgola e senza slash finale
FRONTEND_ORIGINS=http://localhost:3000

# Lascia vuoto in locale; in produzione usa .ecotracker.it
SESSION_COOKIE_DOMAIN=

# Per una singola istanza va bene memory://; con più istanze usa Redis
RATELIMIT_STORAGE_URI=memory://

# AWS e Cognito
AWS_REGION=eu-south-1
COGNITO_USER_POOL_ID=replace-with-cognito-user-pool-id
COGNITO_CLIENT_ID=replace-with-cognito-client-id
COGNITO_CLIENT_SECRET=replace-with-cognito-client-secret
DYNAMODB_TABLE_NAME=EcoTrack_viaggi

# Preferisci un IAM Role. Queste due variabili servono solo se l'hosting non supporta ruoli.
AWS_ACCESS_KEY_ID=replace-only-when-required-by-hosting
AWS_SECRET_ACCESS_KEY=replace-only-when-required-by-hosting

# Compatibilità con una sola chiave Google. Non inserirla mai nel frontend.
GOOGLE_API_KEY=replace-with-your-restricted-google-api-key
